# PullMate Environment Configuration
# Copy this file to .env and configure with your GitHub OAuth Application details.

# GitHub OAuth Application Client ID (Required for GitHub Device Flow authentication)
# Register a new OAuth App at https://github.com/settings/developers
# - Application name: PullMate
# - Homepage URL: https://github.com
# - Authorization callback URL: https://github.com (not strictly used for device flow, but required by GitHub)
# - Enable Device Flow under the OAuth App settings in GitHub Developer Settings
GITHUB_CLIENT_ID=your_github_oauth_client_id_here

# Optional: Default check interval in minutes (15, 30, 60, 120)
DEFAULT_CHECK_INTERVAL_MINUTES=30

# GitHub Releases & Download URLs (accessible in Vite frontend via import.meta.env)
VITE_RELEASES_URL=https://github.com/Shamil2k7/pullmate/releases
VITE_DOWNLOAD_URL=https://github.com/Shamil2k7/pullmate/releases/latest/download/PullMate-Setup-1.0.0.exe
