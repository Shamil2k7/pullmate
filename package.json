{
  "name": "pullmate",
  "version": "1.0.0",
  "description": "Your adorable GitHub-connected desktop Git companion for Windows",
  "main": "electron/main.cjs",
  "author": "PullMate Team",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k -r \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 && electron .",
    "build:react": "vite build",
    "build:electron": "vite build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --dir",
    "dist": "vite build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win nsis",
    "test": "vitest run"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "vite": "^6.2.0",
    "vitest": "^3.0.7",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.pullmate.app",
    "productName": "PullMate",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PullMate"
    }
  }
}
